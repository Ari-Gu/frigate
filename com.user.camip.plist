<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.user.camip</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/mac/project/frigate/sync_camera_ip.sh</string>
    </array>
    <!-- 每 5 分钟核对一次摄像头 IP；摄像头走 DHCP，漂移后 go2rtc 会一直 UDP 超时 -->
    <key>StartInterval</key>
    <integer>300</integer>
    <key>RunAtLoad</key>
    <true/>
    <key>StandardOutPath</key>
    <string>/Users/mac/project/frigate/logs/sync_camera_ip.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/mac/project/frigate/logs/sync_camera_ip.err</string>
</dict>
</plist>
