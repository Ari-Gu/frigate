# 由脚本从 .ENV 反向生成：保留每一项的配置说明，值全部清空。
# 部署时 cp .ENV.example .ENV 后按注释填自己的值；.ENV 已被 .gitignore 排除。

# =============================================================================
#  Frigate 跌倒监控 · 服务配置文件  (.ENV)
# -----------------------------------------------------------------------------
#  格式   : KEY=VALUE  # 功能注释        （注释可省略，写 `#`，前面留一个空格）
#  注释   : `#` 前面有空白才算行尾注释 —— 值里出现 abc#def 不会被误切；
#           整行 `#` 开头为纯注释行；值两端加引号则按字面量处理，不切注释。
#  生效   : 告警桥启动时读取本文件并注入运行环境，等号右边就是服务实际生效值。
#  优先级 : 真实环境变量 > .ENV 文件 > 代码内置默认值
#           （要让文件反过来压过环境变量：DOTENV_PRIORITY=file）
#           ⚠️ 同一个键不要在 launchd plist 里重复声明，否则 plist 会静默盖住本文件。
#  校验   : /usr/bin/python3 fall_alert_bridge.py --env-check
#  改完生效: launchctl kickstart -k gui/$(id -u)/com.user.fallalert
#  ⚠️ 不要在这里放 webhook / 应用密钥（那些走 feishu_app.conf）。
# =============================================================================
# ── ① 连接摄像头的相关关键参数 ───────────────────────────────────────────────
# 监控服务不直连相机，而是从本机 frigate 取流取事件；相机真实地址由 go2rtc.yaml 维护。
FRIGATE_URL=  # frigate 容器 API 地址（取流、取事件都走它）
CAMERAS=  # 要监控的相机名=frigate camera name，逗号分隔，ALL=全部
CAMERA_NAME=  # 相机名登记值（与 CAMERAS 对应，仅核对用，不参与取流）
CAMERA_IP=  # 相机局域网 IP；取流以 go2rtc.yaml 为准，此项供交叉核对
CAMERA_DID=  # 小米云设备 ID（did），用于云端查权威 LAN 地址
CAMERA_MODEL_ID=  # 小米相机型号标识
CAMERA_UID=  # 小米账号 UID
CAMERA_REGION=  # 小米云服务区域
MIN_CAM_FPS=  # 采集帧率低于此值即视为流已断，跳过视觉判定（防拿冻结帧喂模型）
# ── ② 监控使用的大模型 ───────────────────────────────────────────────────────
# 视觉判定走 agnes（当前唯一配了 Key 的通道），两个模型按序尝试、自动降级切换。
VISION_ENABLED=  # 是否启用 AI 视觉判定通道：1=开，0=关（关了只剩几何判定）
AGNES_BASE=  # 模型服务地址（OpenAI 兼容接口）
AGNES_MODELS=  # 候选模型池，按序尝试；超时/变慢/报错自动换下一个
VISION_DEADLINE_MULTI=  # 单次多帧模型调用的硬超时(秒)，超时即切下一个模型
# ── ③ 监控使用的判断方式 ─────────────────────────────────────────────────────
# 双通道并行、任一命中即告警：几何判定（包围框宽高比+重心，无需 Key）＋ AI 视觉（多帧序列问模型）。
VISION_FRAMES=  # AI 判定连拍帧数（只有序列才能区分"弯腰捡东西"与"正在倒下"）
VISION_FRAME_GAP=  # 连拍帧之间的间隔(秒)
VISION_FRAME_HEIGHT=  # 送模型前降采样到的高度(px)，越低越快
VISION_FRAME_QUALITY=  # 重编码 JPEG 质量(1-100)，越高越清晰也越慢
FALL_KEYWORDS=  # 模型回话关键词兜底：命中即视为跌倒
FLOOR_ALERT_STRICT=  # 贴地严格策略：1=坐/跪在地上也告警；0=只认明确倒地
FLOOR_POSTURE_GAP=  # 姿态词到 "on the floor" 的最大字符间隔，调大更容易命中贴地
MULTI_PERSON_MODE=  # 同框多人时：geo=只忽略几何通道 / all=整条忽略 / off=不忽略
MULTI_PERSON_MIN=  # 判定"同框多人"的人数下限
# ── ④ 监控频率 ───────────────────────────────────────────────────────────────
POLL_INTERVAL=  # 事件轮询间隔(秒)，几何通道的实际采样节奏
VISION_EVERY=  # 同一事件隔多久重新问一次模型(秒)，越小越灵敏也越耗额度
STREAM_PROBE_EVERY=  # 断流探测间隔(秒)
GEO_LOG_EVERY=  # 几何状态日志节流(秒)，防止刷屏
# ── ⑤ 告警频率 ───────────────────────────────────────────────────────────────
ALERT_COOLDOWN=  # 同一相机两次跌倒告警的最小间隔(秒)
FALL_WINDOW=  # 判定时间窗口(秒)，窗口内累计命中即算
STREAM_ALERT_SEC=  # 连续多少秒无画面才发断流告警(1800=30分钟)
STREAM_ALERT_COOLDOWN=  # 断流告警的重复间隔(秒)
STREAM_ALERT_SILENT=  # 1=静默"视频流类"通知（断流/自愈）；跌倒告警永远不受影响
VISION_BLIND_SEC=  # 视觉通道连续失败多久算"盲窗"并发告警(秒)
VISION_BLIND_COOLDOWN=  # 盲窗告警的冷却(秒)
STREAM_RECOVER=  # 画面异常时是否自动执行自愈脚本：1=开，0=关
STREAM_RECOVER_AFTER=  # 画面异常持续多少秒后开始自愈
STREAM_RECOVER_COOLDOWN=  # 两次自愈动作的最小间隔(秒)
# ── ⑥ 敏感度参数 ─────────────────────────────────────────────────────────────
# 总原则：调大 → 更敏感（少漏报、多误报）；调小 → 更保守（少误报、多漏报）。
FALL_ASPECT=  # 几何跌倒阈值：包围框宽/高 ≥ 此值（越大越要求"躺平"）
FALL_LOWER=  # 几何跌倒阈值：重心 y ≥ 此值（越接近 1 越要靠画面底部）
FALL_FRAMES=  # 几何通道需连续命中几次才告警
GENAI_FRAMES=  # AI 视觉"强信号"（明确躺/倒）确认次数，一般保持 1
GENAI_WEAK_FRAMES=  # AI 视觉"弱信号"（坐/跪在地上等软升级）确认次数，挡单帧幻觉
WEAK_MIN_GAP=  # 弱信号去抖：两次弱命中相隔 ≥ 此秒数才算独立观测（10-07 22:49 坐沙发误报修复）
NEAR_ASPECT=  # "近失"宽高比阈值，仅记日志不告警（调参时观察用）
NEAR_LOWER=  # "近失"重心阈值，仅记日志不告警
STATIONARY_SPEED=  # 平均估计速度低于此值视为静止
FRAME_MIN_BYTES=  # 有效帧最小字节数，小于此值判为错误帧
FRAME_RETRIES=  # 同一取帧来源最多重试几次
